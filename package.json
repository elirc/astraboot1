{
  "name": "devpractice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts && esbuild apps/api/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.js",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:api": "vitest run tests/api.test.ts",
    "test:e2e": "vite build --mode verification --config apps/web/vite.config.ts && playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "owner:create": "tsx scripts/owner.ts create",
    "owner:reset": "tsx scripts/owner.ts reset",
    "content:build": "tsx packages/content-tools/src/cli.ts build",
    "content:validate": "tsx packages/content-tools/src/cli.ts validate",
    "maintenance": "tsx scripts/maintenance.ts",
    "api:docs": "tsx scripts/openapi.ts",
    "content:assemble": "node scripts/build-missions.mjs && node scripts/build-curriculum.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.2",
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "10.1.3",
    "@prisma/client": "6.16.2",
    "@tanstack/react-query": "5.87.4",
    "argon2": "0.44.0",
    "codemirror": "6.0.2",
    "dotenv": "17.2.2",
    "fastify": "5.12.3",
    "quickjs-emscripten": "0.31.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "typescript": "5.9.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.9",
    "eslint": "9.35.0",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript-eslint": "8.43.0",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
