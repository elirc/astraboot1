{
  "name": "support-desk-training",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx api/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx api/seed.ts",
    "test:baseline": "vitest run tests/baseline.test.ts",
    "test:mission": "vitest run tests/interface.test.tsx",
    "test:api": "vitest run tests/api.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@tanstack/react-query": "5.87.4",
    "fastify": "5.12.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.3",
    "zod": "3.25.76",
    "dotenv": "17.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.8.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.3.6",
    "vitest": "3.2.4",
    "typescript": "5.9.2",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "jsdom": "26.1.0"
  }
}
